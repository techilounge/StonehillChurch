# Stonehill local environment example.
# Copy this file to .env.local and replace placeholders.
# Do not commit .env.local or real secrets.

# Public Firebase Web App config. These values are browser-visible by design.
NEXT_PUBLIC_FIREBASE_API_KEY="your_firebase_web_api_key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your_project_id.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your_project_id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your_project_id.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="your_messaging_sender_id"
NEXT_PUBLIC_FIREBASE_APP_ID="your_firebase_web_app_id"
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID="your_measurement_id_optional"
NEXT_PUBLIC_FIREBASE_APPCHECK_SITE_KEY="your_recaptcha_app_check_site_key"
# Local development only. Use "true" to print a debug token in the browser
# console, then register that token in Firebase App Check. Leave unset in
# production.
NEXT_PUBLIC_FIREBASE_APPCHECK_DEBUG_TOKEN=""

# Public site URL used for metadata, canonical URLs, and sitemap generation.
NEXT_PUBLIC_SITE_URL="https://your-domain.example"

# Firebase Admin SDK. Server-only. Never expose these in client-side code.
FIREBASE_ADMIN_PROJECT_ID="your_project_id"
FIREBASE_ADMIN_CLIENT_EMAIL="firebase-adminsdk-placeholder@your_project_id.iam.gserviceaccount.com"
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_private_key_here\n-----END PRIVATE KEY-----\n"

# YouTube integration.
YOUTUBE_API_KEY="your_youtube_data_api_key"
YOUTUBE_CHANNEL_ID="your_youtube_channel_id"

# Email integration.
RESEND_API_KEY="your_resend_api_key"
# Verified Resend sender. Use a fully qualified domain you've verified in
# Resend, e.g. "Stonehill Church <admin@updates.stonehillchurch.org>".
# If unset, invite emails fall back to Resend's onboarding sandbox sender,
# which works for development but should NOT be used in production.
RESEND_FROM_EMAIL="Stonehill Church <admin@updates.stonehillchurch.org>"

# Initial admin seed user. Used only by npm run seed:firestore.
ADMIN_SEED_EMAIL="admin@example.com"
ADMIN_SEED_PASSWORD="replace_with_a_strong_temporary_password"
ADMIN_SEED_NAME="Stonehill Admin"

# Firebase emulator hosts. Replace these when running local emulators, or leave
# unset in .env.local when using the hosted Firebase project.
FIRESTORE_EMULATOR_HOST="your_firestore_emulator_host_optional"
FIREBASE_AUTH_EMULATOR_HOST="your_auth_emulator_host_optional"
FIREBASE_STORAGE_EMULATOR_HOST="your_storage_emulator_host_optional"

# Optional cache helpers. Dev/build move .next aside by default on Windows.
# Set CLEAN_NEXT_DEV_CACHE to 1 for a one-time forced .next cleanup before dev/build.
CLEAN_NEXT_DEV_CACHE="0"
SKIP_NEXT_DEV_CLEAN="0"
