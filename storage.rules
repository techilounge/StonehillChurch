rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function role() {
      return signedIn() ? request.auth.token.role : null;
    }

    function approved() {
      return signedIn() && request.auth.token.approved == true;
    }

    function hasRole(roles) {
      return approved() && role() in roles;
    }

    function adminOrHigher() {
      return hasRole(["SUPER_ADMIN", "ADMIN"]);
    }

    function editorOrHigher() {
      return hasRole(["SUPER_ADMIN", "ADMIN", "EDITOR"]);
    }

    function viewerOrHigher() {
      return hasRole(["SUPER_ADMIN", "ADMIN", "EDITOR", "VIEWER"]);
    }

    function publicApprovedMedia() {
      return resource != null &&
        resource.metadata.public == "true" &&
        resource.metadata.approved == "true";
    }

    function validImageMimeType() {
      return request.resource.contentType == "image/webp";
    }

    function validImagePath() {
      return request.resource.name.matches(".*\\.webp$");
    }

    function isWebpUpload() {
      return request.resource.contentType == "image/webp";
    }

    function hasCompressionPipelineMetadata() {
      return request.resource.metadata.compression == "auto" ||
        request.resource.metadata.uploadPipeline == "compressed";
    }

    function validImagePipeline() {
      return isWebpUpload() && hasCompressionPipelineMetadata();
    }

    function validImageSize() {
      return request.resource.size <= 5 * 1024 * 1024;
    }

    function validAltTextMetadata() {
      return request.resource.metadata.altText is string &&
        request.resource.metadata.altText.size() >= 8 &&
        request.resource.metadata.altText.size() <= 200;
    }

    function editorCannotSelfApprovePublicMedia() {
      return !hasRole(["EDITOR"]) ||
        (request.resource.metadata.public != "true" &&
          request.resource.metadata.approved != "true");
    }

    function validCmsImageUpload() {
      return validImageMimeType() &&
        validImagePath() &&
        validImageSize() &&
        validImagePipeline() &&
        validAltTextMetadata() &&
        request.resource.metadata.uploadedBy == request.auth.uid &&
        editorCannotSelfApprovePublicMedia();
    }

    function isPopupVideoPath() {
      return request.resource.name.matches("^media/videos/.*\\.mp4$");
    }

    function validPopupVideoUpload() {
      return request.resource.contentType == "video/mp4" &&
        request.resource.size <= 25 * 1024 * 1024 &&
        request.resource.metadata.uploadPipeline == "popup-video" &&
        request.resource.metadata.uploadedBy == request.auth.uid &&
        editorCannotSelfApprovePublicMedia();
    }

    // More-specific match must come before /media/{allPaths=**}. Server-side
    // uploads via Admin SDK bypass these rules; this block is defense-in-depth
    // so a future direct-from-browser flow doesn't accidentally hit the image
    // validator (which rejects video/mp4).
    match /media/videos/{allPaths=**} {
      allow read: if publicApprovedMedia() || viewerOrHigher();
      allow write: if editorOrHigher() && isPopupVideoPath() && validPopupVideoUpload();
      allow delete: if adminOrHigher();
    }

    match /media/{allPaths=**} {
      allow read: if publicApprovedMedia() || viewerOrHigher();
      allow write: if editorOrHigher() && validCmsImageUpload();
      allow delete: if adminOrHigher();
    }

    match /public/{allPaths=**} {
      allow read: if publicApprovedMedia();
      allow write: if adminOrHigher() && validCmsImageUpload();
      allow delete: if adminOrHigher();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
